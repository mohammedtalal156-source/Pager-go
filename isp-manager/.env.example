# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase:
# Project Settings → API Keys / Data API
# قيم عامة (ليست سرية) لمشروع Supabase الحالي (TAJIR، المرجع iqzicolbbrrsrhykipif)
NEXT_PUBLIC_SUPABASE_URL=https://iqzicolbbrrsrhykipif.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CXu4_DBTrsT__c-s580ojw_uDRrxQLv

# سري — على الخادم فقط. لا تضعه في المحادثة ولا في git.
# من لوحة Supabase → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=

# رمز عشوائي (16 حرفاً على الأقل) لصفحة الإعداد الأولي /setup
# مثال لتوليده: openssl rand -hex 24
SETUP_TOKEN=

# اختياري: النطاق المستخدم لتحويل اسم المستخدم إلى بريد داخلي في Supabase Auth
STAFF_EMAIL_DOMAIN=staff.isp.local
